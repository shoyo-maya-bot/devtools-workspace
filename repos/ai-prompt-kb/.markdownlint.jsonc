{
  "default": true,
  // 日本語は 1 行が長くなりやすいので行長は見ない
  "MD013": false,
  // 同名見出しは兄弟間のみ禁止
  "MD024": { "siblings_only": true },
  // front matter の title を H1 とみなさない（本文の H1 を正とする）
  "MD025": { "front_matter_title": "" },
  // Material の grid cards 等で HTML を使う
  "MD033": { "allowed_elements": ["div", "br"] },
  // 前提ブロック内の {{ }} や < > を URL と誤検知しない
  "MD034": false,
  // 1 行目の H1 は front matter の後に置く
  "MD041": false,
  // コードフェンスは ``` / ```` を混在させる（本文にフェンスを含むため）
  "MD046": { "style": "fenced" },
  // テーブル整形はエディタ任せにする
  "MD060": false
}
